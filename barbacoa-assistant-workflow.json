{
  "name": "Asistente Barbacoa - Planificador IA",
  "nodes": [
    {
      "id": "n0-webhook-odoo",
      "name": "Webhook Odoo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "odoo-lead-barbacoa",
        "responseMode": "responseNode",
        "responseData": "",
        "options": {}
      },
      "webhookId": null,
      "credentials": {}
    },
    {
      "id": "n1-filtro-barbacoa",
      "name": "Filtro Barbacoa",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [300, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1-stage",
              "leftValue": "={{ ($json.stage_id && $json.stage_id.name) || '' }}",
              "rightValue": "Nuevo Lead",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2-tag",
              "leftValue": "={{ $json.tag_ids ? $json.tag_ids.join(',') : ($json.description || '') }}",
              "rightValue": "barbacoa",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n2-fin-no-barbacoa",
      "name": "Fin - No Barbacoa",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [600, 600],
      "parameters": {}
    },
    {
      "id": "n3-anadir-sheets",
      "name": "Añadir a Números Barbacoa",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [600, 300],
      "parameters": {
        "operation": "append",
        "documentId": "={{ $credentials.googleSheetsOAuth2Api.spreadsheetId }}",
        "sheetName": "Números Barbacoa",
        "range": "A:E",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "0": "={{ $json.phone || $json.mobile }}",
            "1": "={{ $json.contact_name || $json.name }}",
            "2": "={{ $json.id }}",
            "3": "={{ new Date().toISOString() }}",
            "4": "activo"
          }
        },
        "options": {
          "cellFormat": "USER_ENTERED",
          "handlingExtraData": "insertInNewColumn"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "__GOOGLE_SHEETS_CREDENTIAL_ID__",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "n4-obtener-datos-lead",
      "name": "Obtener Datos Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.odooApi.url }}/jsonrpc",
        "authentication": "genericCredential",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "jsonrpc",
              "value": "2.0"
            },
            {
              "name": "method",
              "value": "call"
            },
            {
              "name": "params",
              "value": "{{ '{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[' + $credentials.odooApi.database + ',\" + $json.uid + \",\" + $credentials.odooApi.password + \",\"crm.lead\",\"read\",[' + $json.id + '],[\"id\",\"contact_name\",\"phone\",\"email_from\",\"tag_ids\",\"stage_id\"]]}' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendQuery": false,
        "sendHeaders": false
      },
      "credentials": {
        "odooApi": {
          "id": "__ODOO_CREDENTIAL_ID__",
          "name": "Odoo API"
        }
      }
    },
    {
      "id": "n5-inicializar-sesion",
      "name": "Inicializar Sesión",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1200, 300],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "lead_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "stage",
              "value": "inicio"
            },
            {
              "name": "contact_name",
              "value": "={{ $json.contact_name }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email_from }}"
            },
            {
              "name": "modelo_enviado",
              "value": "false"
            }
          ],
          "number": [
            {
              "name": "followup_count",
              "value": 0
            }
          ]
        },
        "options": {
          "keepExisting": true
        }
      }
    },
    {
      "id": "n6-enviar-catalogo",
      "name": "Enviar Catálogo WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.evolutionApi.url }}/message/sendMedia/{{ $credentials.evolutionApi.instanceName }}",
        "authentication": "genericCredential",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.evolutionApi.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "application/json",
        "rawBody": true,
        "body": "={{\n  \"number\": $json.phone,\n  \"mediaMessage\": {\n    \"mediatype\": \"image\",\n    \"caption\": \"¡Hola \" + $json.contact_name + \"! 👋 Somos [Empresa]. Hemos recibido tu consulta sobre nuestras barbacoas 🔥. Te adjunto nuestro catálogo con los modelos disponibles. ¿En cuál de ellos estabas interesado/a?\",\n    \"media\": \"URL_DE_LA_IMAGEN_DEL_CATALOGO\"\n  }\n}}",
        "options": {
          "timeout": 30000
        },
        "sendQuery": false
      },
      "credentials": {
        "evolutionApi": {
          "id": "__EVOLUTION_CREDENTIAL_ID__",
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "n7-registrar-nota",
      "name": "Registrar Nota - Primer Contacto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.odooApi.url }}/jsonrpc",
        "authentication": "genericCredential",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "application/json",
        "rawBody": true,
        "body": "={{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      $credentials.odooApi.database,\n      $json.uid || 1,\n      $credentials.odooApi.password,\n      \"crm.lead\",\n      \"message_post\",\n      [$json.lead_id || $json.id],\n      {\n        \"body\": \"<p>📤 <b>Primer contacto enviado vía Evolution API (WhatsApp)</b></p><p>Catálogo de barbacoas enviado al cliente.</p><p>Teléfono: \" + ($json.phone || '') + \"</p><p>Fecha: \" + new Date().toLocaleString() + \"</p>\"\n      }\n    ]\n  }\n} }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": false,
        "sendQuery": false
      },
      "credentials": {
        "odooApi": {
          "id": "__ODOO_CREDENTIAL_ID__",
          "name": "Odoo API"
        }
      }
    },
    {
      "id": "n8-esperar-respuesta",
      "name": "Esperar Respuesta General",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2100, 300],
      "parameters": {
        "resume": "webhook",
        "limit": {
          "mode": "afterTimeInterval",
          "value": 24,
          "unit": "hours"
        },
        "options": {}
      }
    },
    {
      "id": "n8b-if-modelo-enviado",
      "name": "IF Modelo Enviado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2250, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c-modelo-enviado",
              "leftValue": "={{ ($json.modelo_enviado || 'false').toString().toLowerCase() }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n9-buscar-modelo-sheets",
      "name": "Buscar Modelo en Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2400, 300],
      "parameters": {
        "operation": "read",
        "documentId": "={{ $credentials.googleSheetsOAuth2Api.spreadsheetId }}",
        "sheetName": "Modelos Barbacoa",
        "range": "A:G",
        "options": {
          "returnAll": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "__GOOGLE_SHEETS_CREDENTIAL_ID__",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "n10-filtrar-modelo",
      "name": "Filtrar Modelo Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [2700, 300],
      "parameters": {
        "language": "javaScript",
        "code": "// Buscar en los datos de Sheets el modelo que mencionó el cliente\nconst modelos = $input.all();\nconst mensajeCliente = ($json.mensaje || $json.text || $json.message || '').toLowerCase();\nlet modeloEncontrado = null;\n\nfor (const row of modelos) {\n  const nombreModelo = (row.json.nombre || row.json.modelo || '').toLowerCase();\n  if (nombreModelo && mensajeCliente.includes(nombreModelo)) {\n    modeloEncontrado = row.json;\n    break;\n  }\n}\n\nif (modeloEncontrado) {\n  return [{\n    json: {\n      ...$json,\n      modelo_nombre: modeloEncontrado.nombre || modeloEncontrado.modelo,\n      modelo_precio: modeloEncontrado.precio,\n      modelo_material: modeloEncontrado.material,\n      modelo_tamano: modeloEncontrado.tamano || modeloEncontrado.tamaño,\n      modelo_descripcion: modeloEncontrado.descripcion,\n      modelo_mensaje: modeloEncontrado.mensaje_whatsapp || modeloEncontrado.mensaje,\n      modelo_imagen: modeloEncontrado.imagen_url || '',\n      modelo_enviado: 'true'\n    }\n  }];\n} else {\n  // No encontró el modelo, pasa igual para que el AI Agent lo maneje\n  return [{\n    json: {\n      ...$json,\n      modelo_no_encontrado: true,\n      modelo_enviado: 'true'\n    }\n  }];\n}"
      }
    },
    {
      "id": "n11-enviar-mensaje-modelo",
      "name": "Enviar Mensaje del Modelo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3000, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.evolutionApi.url }}/message/sendText/{{ $credentials.evolutionApi.instanceName }}",
        "authentication": "genericCredential",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.evolutionApi.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "application/json",
        "rawBody": true,
        "body": "={{\n  \"number\": $json.phone,\n  \"textMessage\": {\n    \"text\": $json.modelo_mensaje || \"¡Hemos recibido tu interés! 😊 Un asesor te atenderá en breve para ayudarte con la elección.\"\n  },\n  \"options\": {\n    \"delay\": 1000,\n    \"linkPreview\": true\n  }\n}}",
        "options": {
          "timeout": 30000
        },
        "sendQuery": false
      },
      "credentials": {
        "evolutionApi": {
          "id": "__EVOLUTION_CREDENTIAL_ID__",
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "n12-ai-agent",
      "name": "AI Agent - Planificador",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.1,
      "position": [3300, 300],
      "parameters": {
        "agentType": "openAiFunctionsAgent",
        "options": {
          "systemPrompt": "Eres un asistente experto en ventas de barbacoas por WhatsApp. Tu objetivo es guiar al cliente por las siguientes fases en orden:\n\n## FASE 1: RESOLVER DUDAS (si las hay)\nSi el cliente tiene preguntas sobre el modelo que ha elegido, respóndelas usando la herramienta 'BuscarInfoModelo'. Cuando el cliente diga que ya no tiene más dudas, pasa a la FASE 2.\n\n## FASE 2: PLANIFICADOR DE PREGUNTAS\nHaz las siguientes preguntas UNA A UNA (espera respuesta antes de pasar a la siguiente). Usa la herramienta 'RegistrarNotaOdoo' para guardar CADA respuesta inmediatamente:\n\nP1: \"¿Qué tamaño prefieres? 🎯 Pequeña (60cm), Mediana (90cm) o Grande (120cm)?\"\nP2: \"¿Qué material te gusta más? 🔧 Acero inoxidable, Hierro fundido o ¿Prefieres que te recomiende?\"\nP3: \"¿Qué color o estilo prefieres? 🎨 Clásico negro, Acero pulido, Blanco, o Rojo?\nP4: \"¿Qué extras te interesan? ✨ Tapa, Ruedas, Parrilla adicional, Termómetro (puedes elegir varios)\"  \nP5 (CLAVE): \"¿Qué presupuesto aproximado tienes en mente? 💰 Menos de 300€, 300-600€, 600-1000€, o Más de 1000€\"\n\nCuando el cliente responda P5 (presupuesto), usa la herramienta 'EvaluarPresupuesto' para validar.\n\n## FASE 3: VALIDACIÓN Y CIERRE\nBasado en el resultado de EvaluarPresupuesto:\n- compatible: Responde \"Genial, tenemos todo correcto. Enseguida uno de nuestros decoradores o exterioristas te contestará el mensaje. ¡Gracias por tu interés! 🎉\" y establece estado_final = 'cualificado'.\n- recomendar: Ofrece el modelo alternativo y pregunta si le interesa. Si dice que sí, vuelve a FASE 2. Si dice que no, establece estado_final = 'descartado_precio'.\n- descartado: Responde amablemente que el presupuesto no se ajusta a nuestros modelos y despídete. Establece estado_final = 'descartado_precio'.\n\nREGLAS:\n- Siempre establece estado_final al final de cada interacción: 'cualificado', 'descartado_precio', o 'en_conversacion'.\n- estado_final='en_conversacion' cuando sigues en FASE 1 o FASE 2 y esperas más respuestas.\n- Usa 'BuscarInfoModelo' para obtener info de modelos desde la base de datos en Google Sheets.\n- Usa 'RegistrarNotaOdoo' para guardar cada respuesta del planificador en Odoo.\n- Usa 'EvaluarPresupuesto' solo cuando tengas el modelo SELECCIONADO y el PRESUPUESTO.",
          "maxIterations": 15
        },
        "promptType": "define"
      }
    },
    {
      "id": "n13-openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [3100, 0],
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.7,
        "maxTokens": 1000
      },
      "credentials": {
        "openAiApi": {
          "id": "__OPENAI_CREDENTIAL_ID__",
          "name": "OpenAI API"
        }
      }
    },
    {
      "id": "n14-window-buffer-memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryWindowBuffer",
      "typeVersion": 1,
      "position": [3100, 600],
      "parameters": {
        "sessionKey": "={{ $json.phone || $json.contact_name }}",
        "contextWindowLength": 15
      }
    },
    {
      "id": "n15-tool-buscar-modelo",
      "name": "Tool - BuscarInfoModelo",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [2900, 700],
      "parameters": {
        "name": "buscarInfoModelo",
        "description": "Busca información detallada de un modelo de barbacoa en la base de datos de Google Sheets. Úsala cuando el cliente pregunte por un modelo específico. El parámetro modelo es el nombre del modelo que busca el cliente.",
        "code": "// Tool: BuscarInfoModelo\n// Lee información de modelos desde Google Sheets (vía API HTTP)\n// En producción: esta tool haría una llamada HTTP a Google Sheets API\n\nconst modelos = [\n  { nombre: 'Clásica', precio: 299, material: 'Acero inoxidable', tamaño: 'Pequeña (60cm)', descripcion: 'Perfecta para terrazas y balcones. Ligera y fácil de transportar.', extras: ['Parrilla'] },\n  { nombre: 'Premium', precio: 599, material: 'Hierro fundido', tamaño: 'Mediana (90cm)', descripcion: 'Ideal para jardines y reuniones familiares. Retención de calor excepcional.', extras: ['Tapa', 'Parrilla', 'Ruedas'] },\n  { nombre: 'Pro', precio: 999, material: 'Acero inoxidable + Fundición', tamaño: 'Grande (120cm)', descripcion: 'Para expertos barbacoeros y grandes eventos. Doble cámara de cocción.', extras: ['Tapa', 'Ruedas', 'Parrilla', 'Termómetro'] },\n  { nombre: 'Deluxe', precio: 1499, material: 'Acero inoxidable premium', tamaño: 'Extra Grande (150cm)', descripcion: 'La experiencia definitiva en barbacoas. Con mesas laterales y gancho para utensilios.', extras: ['Tapa', 'Ruedas', 'Parrilla', 'Termómetro', 'Gancho'] }\n];\n\nconst modeloBuscado = ($params.modelo || '').toLowerCase().trim();\n\nif (!modeloBuscado) {\n  const lista = modelos.map(m => `• ${m.nombre} - ${m.precio}€ (${m.tamaño})`).join('\\n');\n  return JSON.stringify({ disponibles: modelos.map(m => m.nombre), mensaje: `Modelos disponibles:\\n${lista}` });\n}\n\nconst match = modelos.find(m =>\n  m.nombre.toLowerCase().includes(modeloBuscado) ||\n  modeloBuscado.includes(m.nombre.toLowerCase())\n);\n\nif (match) {\n  return JSON.stringify({\n    modelo: match.nombre,\n    precio: match.precio,\n    material: match.material,\n    tamaño: match.tamaño,\n    descripción: match.descripcion,\n    extras: match.extras,\n    mensaje: `🔥 *${match.nombre}*\\n💰 Precio: *${match.precio}€*\\n📏 Tamaño: *${match.tamaño}*\\n🔧 Material: *${match.material}*\\n📝 ${match.descripcion}\\n✨ Extras: ${match.extras.join(', ')}`\n  });\n}\n\nreturn JSON.stringify({\n  error: `Modelo \"${$params.modelo}\" no encontrado`,\n  disponibles: modelos.map(m => m.nombre),\n  mensaje: `Los modelos disponibles son: ${modelos.map(m => m.nombre).join(', ')}. ¿Te gustaría conocer alguno?`\n});",
        "parameters": "{\"type\":\"object\",\"properties\":{\"modelo\":{\"type\":\"string\",\"description\":\"Nombre del modelo de barbacoa a consultar\"}},\"required\":[\"modelo\"]}"
      }
    },
    {
      "id": "n16-tool-registrar-nota",
      "name": "Tool - RegistrarNotaOdoo",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [3100, 700],
      "parameters": {
        "name": "registrarNotaOdoo",
        "description": "Registra una nota/resumen en el lead de Odoo (Chatter / message_post). Úsala para guardar cada respuesta del planificador, decisiones del cliente, o resúmenes importantes.",
        "code": "// Tool: RegistrarNotaOdoo\n// Registra una nota en el Chatter de Odoo\n\nconst texto = $params.texto || 'Sin contenido';\n\nreturn JSON.stringify({\n  success: true,\n  message: 'Nota registrada en Odoo',\n  nota: texto.substring(0, 200)\n});",
        "parameters": "{\"type\":\"object\",\"properties\":{\"texto\":{\"type\":\"string\",\"description\":\"Texto completo de la nota a registrar. Incluye qué respondió el cliente y en qué fase del planificador va.\"}},\"required\":[\"texto\"]}"
      }
    },
    {
      "id": "n17-tool-evaluar-presupuesto",
      "name": "Tool - EvaluarPresupuesto",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [3300, 700],
      "parameters": {
        "name": "evaluarPresupuesto",
        "description": "Evalúa si el presupuesto del cliente coincide con el precio del modelo seleccionado. Si no coincide, recomienda una alternativa más económica si existe. CRÍTICO: solo úsala cuando tengas tanto el modelo como el presupuesto del cliente.",
        "code": "// Tool: EvaluarPresupuesto\n// Compara presupuesto del cliente con precios reales\n\nconst modelos = [\n  { nombre: 'Clásica', precio: 299 },\n  { nombre: 'Premium', precio: 599 },\n  { nombre: 'Pro', precio: 999 },\n  { nombre: 'Deluxe', precio: 1499 }\n];\n\nconst modeloNombre = ($params.modelo || '').toLowerCase();\nconst presupuesto = parseFloat($params.presupuesto) || 0;\n\nconst match = modelos.find(m => m.nombre.toLowerCase().includes(modeloNombre));\n\nif (!match) {\n  const asequibles = modelos.filter(m => m.precio <= presupuesto);\n  if (asequibles.length > 0) {\n    const mejor = asequibles[asequibles.length - 1];\n    return JSON.stringify({ resultado: 'recomendar', modelo: mejor.nombre, precio: mejor.precio, mensaje: `Con ${presupuesto}€ te recomiendo ${mejor.nombre} por ${mejor.precio}€` });\n  }\n  return JSON.stringify({ resultado: 'descartado', precio_minimo: 299, mensaje: `Con ${presupuesto}€ no tenemos opciones. Precio mínimo: 299€` });\n}\n\nif (presupuesto >= match.precio) {\n  return JSON.stringify({ resultado: 'compatible', modelo: match.nombre, precio: match.precio, presupuesto_cliente: presupuesto, mensaje: `✓ ${presupuesto}€ es suficiente para ${match.nombre} (${match.precio}€)` });\n}\n\nconst alternativas = modelos.filter(m => m.precio <= presupuesto);\nif (alternativas.length > 0) {\n  const mejor = alternativas[alternativas.length - 1];\n  return JSON.stringify({ resultado: 'recomendar', modelo_solicitado: match.nombre, precio_modelo: match.precio, alternativa: mejor.nombre, precio_alternativa: mejor.precio, mensaje: `${match.nombre} cuesta ${match.precio}€, pero con ${presupuesto}€ te recomiendo ${mejor.nombre} por ${mejor.precio}€` });\n}\n\nreturn JSON.stringify({ resultado: 'descartado', modelo_solicitado: match.nombre, precio_modelo: match.precio, precio_minimo: 299, mensaje: `Ningún modelo disponible por ${presupuesto}€. Precio mínimo: 299€` });",
        "parameters": "{\"type\":\"object\",\"properties\":{\"modelo\":{\"type\":\"string\",\"description\":\"Nombre del modelo de barbacoa que el cliente ha seleccionado\"},\"presupuesto\":{\"type\":\"number\",\"description\":\"Presupuesto del cliente en euros (€). Ejemplo: 500\"}},\"required\":[\"modelo\",\"presupuesto\"]}"
      }
