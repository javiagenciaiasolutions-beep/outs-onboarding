{
  "name": "Asistente Barbacoa - Planificador IA",
  "nodes": [
    {
      "id": "n0-webhook-odoo",
      "name": "Webhook Odoo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "odoo-lead-barbacoa",
        "responseMode": "responseNode",
        "responseData": "",
        "options": {}
      },
      "webhookId": null,
      "credentials": {}
    },
    {
      "id": "n1-filtro-barbacoa",
      "name": "Filtro Barbacoa",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1-stage",
              "leftValue": "={{ ($json.stage_id && $json.stage_id.name) || '' }}",
              "rightValue": "Nuevo Lead",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2-tag",
              "leftValue": "={{ $json.tag_ids ? $json.tag_ids.join(',') : ($json.description || '') }}",
              "rightValue": "barbacoa",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n2-fin-no-barbacoa",
      "name": "Fin - No Barbacoa",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        600,
        600
      ],
      "parameters": {}
    },
    {
      "id": "n3-buscar-sheets",
      "name": "Buscar en N\u00fameros Barbacoa",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        600,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": "={{ $credentials.googleSheetsOAuth2Api.spreadsheetId }}",
        "sheetName": "N\u00fameros Barbacoa",
        "range": "A:E",
        "options": {
          "returnAll": false,
          "maxResults": 1,
          "dataLocationOnSheet": "firstRowHeaders"
        },
        "filters": {
          "values": {
            "0": {
              "lookupColumn": "telefono",
              "lookupValue": "={{ $json.phone || $json.mobile }}"
            }
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "__GOOGLE_SHEETS_CREDENTIAL_ID__",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "n3b-if-sheets",
      "name": "IF Lead en Sheets",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "c-sheets-found",
              "leftValue": "={{ $json.telefono || $json.phone || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n3c-anadir-sheets",
      "name": "A\u00f1adir a N\u00fameros Barbacoa",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        600,
        500
      ],
      "parameters": {
        "operation": "append",
        "documentId": "={{ $credentials.googleSheetsOAuth2Api.spreadsheetId }}",
        "sheetName": "N\u00fameros Barbacoa",
        "range": "A:E",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "0": "={{ $json.phone || $json.mobile }}",
            "1": "={{ $json.contact_name || $json.name }}",
            "2": "={{ $json.id }}",
            "3": "={{ new Date().toISOString() }}",
            "4": "activo"
          }
        },
        "options": {
          "cellFormat": "USER_ENTERED",
          "handlingExtraData": "insertInNewColumn"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "__GOOGLE_SHEETS_CREDENTIAL_ID__",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "n4-obtener-datos-lead",
      "name": "Obtener Datos Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.odooApi.url }}/jsonrpc",
        "authentication": "genericCredential",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "jsonrpc",
              "value": "2.0"
            },
            {
              "name": "method",
              "value": "call"
            },
            {
              "name": "params",
              "value": "{{ '{\"service\":\"object\",\"method\":\"execute_kw\",\"args\":[' + $credentials.odooApi.database + ',\" + $json.uid + \",\" + $credentials.odooApi.password + \",\"crm.lead\",\"read\",[' + $json.id + '],[\"id\",\"contact_name\",\"phone\",\"email_from\",\"tag_ids\",\"stage_id\"]]}' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendQuery": false,
        "sendHeaders": false
      },
      "credentials": {
        "odooApi": {
          "id": "__ODOO_CREDENTIAL_ID__",
          "name": "Odoo API"
        }
      }
    },
    {
      "id": "n5-inicializar-sesion",
      "name": "Inicializar Sesi\u00f3n",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "lead_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "stage",
              "value": "inicio"
            },
            {
              "name": "contact_name",
              "value": "={{ $json.contact_name }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email_from }}"
            },
            {
              "name": "modelo_enviado",
              "value": "false"
            }
          ],
          "number": [
            {
              "name": "followup_count",
              "value": 0
            }
          ]
        },
        "options": {
          "keepExisting": true
        }
      }
    },
    {
      "id": "n6-enviar-catalogo",
      "name": "Enviar Cat\u00e1logo WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.evolutionApi.url }}/message/sendMedia/{{ $credentials.evolutionApi.instanceName }}",
        "authentication": "genericCredential",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.evolutionApi.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "application/json",
        "rawBody": true,
        "body": "={{\n  \"number\": $json.phone,\n  \"mediaMessage\": {\n    \"mediatype\": \"image\",\n    \"caption\": \"\u00a1Hola \" + $json.contact_name + \"! \ud83d\udc4b Somos [Empresa]. Hemos recibido tu consulta sobre nuestras barbacoas \ud83d\udd25. Te adjunto nuestro cat\u00e1logo con los modelos disponibles. \u00bfEn cu\u00e1l de ellos estabas interesado/a?\",\n    \"media\": \"URL_DE_LA_IMAGEN_DEL_CATALOGO\"\n  }\n}}",
        "options": {
          "timeout": 30000
        },
        "sendQuery": false
      },
      "credentials": {
        "evolutionApi": {
          "id": "__EVOLUTION_CREDENTIAL_ID__",
          "name": "Evolution API"
        }
      }
    },
    {
      "id": "n7-registrar-nota",
      "name": "Registrar Nota - Primer Contacto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.odooApi.url }}/jsonrpc",
        "authentication": "genericCredential",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "application/json",
        "rawBody": true,
        "body": "={{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      $credentials.odooApi.database,\n      $json.uid || 1,\n      $credentials.odooApi.password,\n      \"crm.lead\",\n      \"message_post\",\n      [$json.lead_id || $json.id],\n      {\n        \"body\": \"<p>\ud83d\udce4 <b>Primer contacto enviado v\u00eda Evolution API (WhatsApp)</b></p><p>Cat\u00e1logo de barbacoas enviado al cliente.</p><p>Tel\u00e9fono: \" + ($json.phone || '') + \"</p><p>Fecha: \" + new Date().toLocaleString() + \"</p>\"\n      }\n    ]\n  }\n} }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": false,
        "sendQuery": false
      },
      "credentials": {
        "odooApi": {
          "id": "__ODOO_CREDENTIAL_ID__",
          "name": "Odoo API"
        }
      }
    },
    {
      "id": "n8-esperar-respuesta",
      "name": "Esperar Respuesta General",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2100,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "limit": {
          "mode": "afterTimeInterval",
          "value": 24,
          "unit": "hours"
        },
        "options": {}
      }
    },
    {
      "id": "n12-ai-agent",
      "name": "AI Agent - Planificador",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.1,
      "position": [
        3300,
        300
      ],
      "parameters": {
        "agentType": "openAiFunctionsAgent",
        "options": {
          "systemPrompt": "Eres un asistente experto en ventas de barbacoas por WhatsApp. Tu objetivo es guiar al cliente por las siguientes fases en orden:\n\n## FASE 1: RESOLVER DUDAS (si las hay)\nSi el cliente tiene preguntas sobre el modelo que ha elegido, resp\u00f3ndelas usando la herramienta 'BuscarInfoModelo'. Cuando el cliente diga que ya no tiene m\u00e1s dudas, pasa a la FASE 2.\n\n## FASE 2: PLANIFICADOR DE PREGUNTAS\nHaz las siguientes preguntas UNA A UNA (espera respuesta antes de pasar a la siguiente). Usa la herramienta 'RegistrarNotaOdoo' para guardar CADA respuesta inmediatamente:\n\nP1: \"\u00bfQu\u00e9 tama\u00f1o prefieres? \ud83c\udfaf Peque\u00f1a (60cm), Mediana (90cm) o Grande (120cm)?\"\nP2: \"\u00bfQu\u00e9 material te gusta m\u00e1s? \ud83d\udd27 Acero inoxidable, Hierro fundido o \u00bfPrefieres que te recomiende?\"\nP3: \"\u00bfQu\u00e9 color o estilo prefieres? \ud83c\udfa8 Cl\u00e1sico negro, Acero pulido, Blanco, o Rojo?\nP4: \"\u00bfQu\u00e9 extras te interesan? \u2728 Tapa, Ruedas, Parrilla adicional, Term\u00f3metro (puedes elegir varios)\"  \nP5 (CLAVE): \"\u00bfQu\u00e9 presupuesto aproximado tienes en mente? \ud83d\udcb0 Menos de 300\u20ac, 300-600\u20ac, 600-1000\u20ac, o M\u00e1s de 1000\u20ac\"\n\nCuando el cliente responda P5 (presupuesto), usa la herramienta 'EvaluarPresupuesto' para validar.\n\n## FASE 3: VALIDACI\u00d3N Y CIERRE\nBasado en el resultado de EvaluarPresupuesto:\n- compatible: Responde \"Genial, tenemos todo correcto. Enseguida uno de nuestros decoradores o exterioristas te contestar\u00e1 el mensaje. \u00a1Gracias por tu inter\u00e9s! \ud83c\udf89\" y establece estado_final = 'cualificado'.\n- recomendar: Ofrece el modelo alternativo y pregunta si le interesa. Si dice que s\u00ed, vuelve a FASE 2. Si dice que no, establece estado_final = 'descartado_precio'.\n- descartado: Responde amablemente que el presupuesto no se ajusta a nuestros modelos y desp\u00eddete. Establece estado_final = 'descartado_precio'.\n\nREGLAS:\n- Siempre establece estado_final al final de cada interacci\u00f3n: 'cualificado', 'descartado_precio', o 'en_conversacion'.\n- estado_final='en_conversacion' cuando sigues en FASE 1 o FASE 2 y esperas m\u00e1s respuestas.\n- Usa 'BuscarInfoModelo' para obtener info de modelos desde la base de datos en Google Sheets.\n- Usa 'RegistrarNotaOdoo' para guardar cada respuesta del planificador en Odoo.\n- Usa 'EvaluarPresupuesto' solo cuando tengas el modelo SELECCIONADO y el PRESUPUESTO.",
          "maxIterations": 15
        },
        "promptType": "define"
      }
    },
    {
      "id": "n13-openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        3100,
        0
      ],
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.7,
        "maxTokens": 1000
      },
      "credentials": {
        "openAiApi": {
          "id": "__OPENAI_CREDENTIAL_ID__",
          "name": "OpenAI API"
        }
      }
    },
    {
      "id": "n14-window-buffer-memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryWindowBuffer",
      "typeVersion": 1,
      "position": [
        3100,
        600
      ],
      "parameters": {
        "sessionKey": "={{ $json.phone || $json.contact_name }}",
        "contextWindowLength": 15
      }
    },
    {
      "id": "n15-tool-buscar-modelo",
      "name": "Tool - BuscarInfoModelo",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        2900,
        700
      ],
      "parameters": {
        "name": "buscarInfoModelo",
        "description": "Busca informaci\u00f3n detallada de un modelo de barbacoa en la base de datos de Google Sheets. \u00dasala cuando el cliente pregunte por un modelo espec\u00edfico. El par\u00e1metro modelo es el nombre del modelo que busca el cliente.",
        "code": "// Tool: BuscarInfoModelo\n// Lee informaci\u00f3n de modelos desde Google Sheets (v\u00eda API HTTP)\n// En producci\u00f3n: esta tool har\u00eda una llamada HTTP a Google Sheets API\n\nconst modelos = [\n  { nombre: 'Cl\u00e1sica', precio: 299, material: 'Acero inoxidable', tama\u00f1o: 'Peque\u00f1a (60cm)', descripcion: 'Perfecta para terrazas y balcones. Ligera y f\u00e1cil de transportar.', extras: ['Parrilla'] },\n  { nombre: 'Premium', precio: 599, material: 'Hierro fundido', tama\u00f1o: 'Mediana (90cm)', descripcion: 'Ideal para jardines y reuniones familiares. Retenci\u00f3n de calor excepcional.', extras: ['Tapa', 'Parrilla', 'Ruedas'] },\n  { nombre: 'Pro', precio: 999, material: 'Acero inoxidable + Fundici\u00f3n', tama\u00f1o: 'Grande (120cm)', descripcion: 'Para expertos barbacoeros y grandes eventos. Doble c\u00e1mara de cocci\u00f3n.', extras: ['Tapa', 'Ruedas', 'Parrilla', 'Term\u00f3metro'] },\n  { nombre: 'Deluxe', precio: 1499, material: 'Acero inoxidable premium', tama\u00f1o: 'Extra Grande (150cm)', descripcion: 'La experiencia definitiva en barbacoas. Con mesas laterales y gancho para utensilios.', extras: ['Tapa', 'Ruedas', 'Parrilla', 'Term\u00f3metro', 'Gancho'] }\n];\n\nconst modeloBuscado = ($params.modelo || '').toLowerCase().trim();\n\nif (!modeloBuscado) {\n  const lista = modelos.map(m => `\u2022 ${m.nombre} - ${m.precio}\u20ac (${m.tama\u00f1o})`).join('\\n');\n  return JSON.stringify({ disponibles: modelos.map(m => m.nombre), mensaje: `Modelos disponibles:\\n${lista}` });\n}\n\nconst match = modelos.find(m =>\n  m.nombre.toLowerCase().includes(modeloBuscado) ||\n  modeloBuscado.includes(m.nombre.toLowerCase())\n);\n\nif (match) {\n  return JSON.stringify({\n    modelo: match.nombre,\n    precio: match.precio,\n    material: match.material,\n    tama\u00f1o: match.tama\u00f1o,\n    descripci\u00f3n: match.descripcion,\n    extras: match.extras,\n    mensaje: `\ud83d\udd25 *${match.nombre}*\\n\ud83d\udcb0 Precio: *${match.precio}\u20ac*\\n\ud83d\udccf Tama\u00f1o: *${match.tama\u00f1o}*\\n\ud83d\udd27 Material: *${match.material}*\\n\ud83d\udcdd ${match.descripcion}\\n\u2728 Extras: ${match.extras.join(', ')}`\n  });\n}\n\nreturn JSON.stringify({\n  error: `Modelo \"${$params.modelo}\" no encontrado`,\n  disponibles: modelos.map(m => m.nombre),\n  mensaje: `Los modelos disponibles son: ${modelos.map(m => m.nombre).join(', ')}. \u00bfTe gustar\u00eda conocer alguno?`\n});",
        "parameters": "{\"type\":\"object\",\"properties\":{\"modelo\":{\"type\":\"string\",\"description\":\"Nombre del modelo de barbacoa a consultar\"}},\"required\":[\"modelo\"]}"
      }
    },
    {
      "id": "n16-tool-registrar-nota",
      "name": "Tool - RegistrarNotaOdoo",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        3100,
        700
      ],
      "parameters": {
        "name": "registrarNotaOdoo",
        "description": "Registra una nota/resumen en el lead de Odoo (Chatter / message_post). \u00dasala para guardar cada respuesta del planificador, decisiones del cliente, o res\u00famenes importantes.",
        "code": "// Tool: RegistrarNotaOdoo\n// Registra una nota en el Chatter de Odoo\n\nconst texto = $params.texto || 'Sin contenido';\n\nreturn JSON.stringify({\n  success: true,\n  message: 'Nota registrada en Odoo',\n  nota: texto.substring(0, 200)\n});",
        "parameters": "{\"type\":\"object\",\"properties\":{\"texto\":{\"type\":\"string\",\"description\":\"Texto completo de la nota a registrar. Incluye qu\u00e9 respondi\u00f3 el cliente y en qu\u00e9 fase del planificador va.\"}},\"required\":[\"texto\"]}"
      }
    },
    {
      "id": "n17-tool-evaluar-presupuesto",
      "name": "Tool - EvaluarPresupuesto",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        3300,
        700
      ],
      "parameters": {
        "name": "evaluarPresupuesto",
        "description": "Eval\u00faa si el presupuesto del cliente coincide con el precio del modelo seleccionado. Si no coincide, recomienda una alternativa m\u00e1s econ\u00f3mica si existe. CR\u00cdTICO: solo \u00fasala cuando tengas tanto el modelo como el presupuesto del cliente.",
        "code": "// Tool: EvaluarPresupuesto\n// Compara presupuesto del cliente con precios reales\n\nconst modelos = [\n  { nombre: 'Cl\u00e1sica', precio: 299 },\n  { nombre: 'Premium', precio: 599 },\n  { nombre: 'Pro', precio: 999 },\n  { nombre: 'Deluxe', precio: 1499 }\n];\n\nconst modeloNombre = ($params.modelo || '').toLowerCase();\nconst presupuesto = parseFloat($params.presupuesto) || 0;\n\nconst match = modelos.find(m => m.nombre.toLowerCase().includes(modeloNombre));\n\nif (!match) {\n  const asequibles = modelos.filter(m => m.precio <= presupuesto);\n  if (asequibles.length > 0) {\n    const mejor = asequibles[asequibles.length - 1];\n    return JSON.stringify({ resultado: 'recomendar', modelo: mejor.nombre, precio: mejor.precio, mensaje: `Con ${presupuesto}\u20ac te recomiendo ${mejor.nombre} por ${mejor.precio}\u20ac` });\n  }\n  return JSON.stringify({ resultado: 'descartado', precio_minimo: 299, mensaje: `Con ${presupuesto}\u20ac no tenemos opciones. Precio m\u00ednimo: 299\u20ac` });\n}\n\nif (presupuesto >= match.precio) {\n  return JSON.stringify({ resultado: 'compatible', modelo: match.nombre, precio: match.precio, presupuesto_cliente: presupuesto, mensaje: `\u2713 ${presupuesto}\u20ac es suficiente para ${match.nombre} (${match.precio}\u20ac)` });\n}\n\nconst alternativas = modelos.filter(m => m.precio <= presupuesto);\nif (alternativas.length > 0) {\n  const mejor = alternativas[alternativas.length - 1];\n  return JSON.stringify({ resultado: 'recomendar', modelo_solicitado: match.nombre, precio_modelo: match.precio, alternativa: mejor.nombre, precio_alternativa: mejor.precio, mensaje: `${match.nombre} cuesta ${match.precio}\u20ac, pero con ${presupuesto}\u20ac te recomiendo ${mejor.nombre} por ${mejor.precio}\u20ac` });\n}\n\nreturn JSON.stringify({ resultado: 'descartado', modelo_solicitado: match.nombre, precio_modelo: match.precio, precio_minimo: 299, mensaje: `Ning\u00fan modelo disponible por ${presupuesto}\u20ac. Precio m\u00ednimo: 299\u20ac` });",
        "parameters": "{\"type\":\"object\",\"properties\":{\"modelo\":{\"type\":\"string\",\"description\":\"Nombre del modelo de barbacoa que el cliente ha seleccionado\"},\"presupuesto\":{\"type\":\"number\",\"description\":\"Presupuesto del cliente en euros (\u20ac). Ejemplo: 500\"}},\"required\":[\"modelo\",\"presupuesto\"]}"
      }
    },
    {
      "id": "n18-enviar-respuesta",
      "name": "Enviar Respuesta WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.evolutionApi.url }}/message/sendText/{{ $credentials.evolutionApi.instanceName }}",
        "authentication": "genericCredential",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.evolutionApi.apiKey }}"
            }
          ]
        },
        "sendBody": true,
